# Meta Model API (https://dev.meta.ai)
MODEL_API_KEY=your_meta_model_api_key_here

META_BASE_URL=https://api.meta.ai/v1

# Multi-model stack
META_GUARD_MODEL=muse-spark-1.3
META_FORENSIC_MODEL=muse-wonder-1.0
META_SAM_MODEL=sam-3.1
META_SAM_ENABLED=1
# Set to 0 to skip SAM's second concept pass (saves tokens)
META_SAM_BROAD_RETRY=1

# Reasoning / token budgets (never set effort to "none")
META_REASONING_EFFORT=low
META_FORENSIC_REASONING_EFFORT=high
META_MAX_COMPLETION_TOKENS=2000
META_FORENSIC_MAX_TOKENS=3500

# Cost tip: demo recording = Attack 01 only.
# Avoid `python stress_test.py 3` unless validating before submit.
# Cheap check: `python stress_test.py smoke`
